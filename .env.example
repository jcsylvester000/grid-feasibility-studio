# Copy to .env.local and fill in. Never commit real values.
# Database (Neon, Singapore). Pooled for the app, direct for migrations.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
# Read-only role for admin pages (created in batch B8)
DATABASE_URL_ADMIN_READER=""
# neon (default) or pglite (local tests only)
DB_DRIVER="neon"

# UploadThing
UPLOADTHING_TOKEN=""

# VectorShift (use the mock until the pipelines are live: npm run mock:vs)
VECTORSHIFT_API_KEY=""
VECTORSHIFT_BASE_URL="http://localhost:4010"
VS_PIPELINE_QUICK_REPORT="mock-quick_report"
VS_PIPELINE_EXECUTIVE_SUMMARY="mock-executive_summary"
VS_PIPELINE_FEASIBILITY_REPORT="mock-feasibility_report"
VS_PIPELINE_TEASER_INTAKE="mock-teaser_intake"
# Optional per-product timeouts in ms (Netlify: at most 840000)
# VS_TIMEOUT_MS_FEASIBILITY_REPORT=""
# Per-product address (overrides VECTORSHIFT_BASE_URL for one product). Example: Quick Report live on
# VectorShift while the others still use the local mock:
#   VECTORSHIFT_BASE_URL="https://api.vectorshift.ai"
#   VS_BASE_URL_EXECUTIVE_SUMMARY="http://localhost:4010"   (and _FEASIBILITY_REPORT, _TEASER_INTAKE)
# How inputs are sent: "fields" (one text input per answer; the live Quick Report pipeline, default for the
# Quick Report) or "run_request" (one JSON input; the BRD contract, default for the other products).
# VS_INPUT_QUICK_REPORT="fields"
VS_MAX_CONCURRENT="10"

# inline (your computer) or netlify (Background Function). On Netlify the default is netlify, so runs never
# wait inside an ordinary function (they stop after about 26-30 seconds); INTERNAL_DISPATCH_SECRET is required there.
RUN_DISPATCH="inline"
INTERNAL_DISPATCH_SECRET=""

FEATURE_TEASER_SCAN="false"
APP_ORIGIN="http://localhost:3000"
# 32+ random characters: protects sign-in rate-limit hashes and the one-time recovery-key cookie
APP_SECRET=""
ALLOW_INDEXING="false"

# Internal report-viewer samples at /design/report/{quick_report|quick_report_teaser|executive_summary|feasibility_report}. Keep false in production.
DESIGN_SAMPLES=false

# File storage: "uploadthing" (default) or "local" (files kept in .data/uploads; tests and offline work only).
UPLOAD_DRIVER=uploadthing
# UPLOAD_LOCAL_DIR=.data/uploads

# Demo scenarios (prototype demos and training): shows "Load the 20 demo scenarios" on the dashboard.
# Always on in development (npm run dev). Keep false in production.
DEMO_MODE=false
# Shared demo login for showcases, "username:password" (needs demo mode). Created on first sign-in. Remove before launch.
DEMO_LOGIN=""
# Prototype banner shows automatically while any product still runs on the stand-in (it names the live ones); force it with PROTOTYPE_MODE=true.
