# Copy to .env.local and fill in. Never commit real values.
# Database (Neon, Singapore). Pooled for the app, direct for migrations.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
# Read-only role for admin pages (created in batch B8)
DATABASE_URL_ADMIN_READER=""
# neon (default) or pglite (local tests only)
DB_DRIVER="neon"

# UploadThing
UPLOADTHING_TOKEN=""

# VectorShift (use the mock until the pipelines are live: npm run mock:vs)
VECTORSHIFT_API_KEY=""
VECTORSHIFT_BASE_URL="http://localhost:4010"
VS_PIPELINE_QUICK_REPORT="mock-quick_report"
VS_PIPELINE_EXECUTIVE_SUMMARY="mock-executive_summary"
VS_PIPELINE_FEASIBILITY_REPORT="mock-feasibility_report"
VS_PIPELINE_TEASER_INTAKE="mock-teaser_intake"
# Optional per-product timeouts in ms (Netlify: at most 840000)
# VS_TIMEOUT_MS_FEASIBILITY_REPORT=""
VS_MAX_CONCURRENT="10"

# inline (your computer) or netlify (Background Function)
RUN_DISPATCH="inline"
INTERNAL_DISPATCH_SECRET=""

FEATURE_TEASER_SCAN="false"
APP_ORIGIN="http://localhost:3000"
ADDRESS_HASH_SALT=""
ALLOW_INDEXING="false"
