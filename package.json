{
  "name": "grid-feasibility-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:netlify": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typegen": "tsx scripts/typegen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "mock:vs": "tsx mock/vectorshift/server.ts",
    "check:budgets": "tsx scripts/check-budgets.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "scan:secrets": "tsx scripts/secret-scan.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=critical"
  },
  "dependencies": {
    "@neondatabase/serverless": "~1.2.0",
    "@node-rs/argon2": "~2.2.2",
    "@uploadthing/react": "~7.3.3",
    "ajv": "~8.20.0",
    "ajv-formats": "~3.0.1",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "drizzle-orm": "~0.45.4",
    "lucide-react": "~1.61.0",
    "next": "~16.4.2",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "server-only": "~0.0.1",
    "tailwind-merge": "~3.7.0",
    "uploadthing": "~7.7.4",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@electric-sql/pglite": "~0.5.11",
    "@netlify/functions": "~6.0.3",
    "@netlify/plugin-nextjs": "~5.16.4",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/postcss": "~4.3.3",
    "@types/node": "~22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "dotenv": "~18.0.8",
    "drizzle-kit": "~0.31.11",
    "eslint": "~9.39.5",
    "eslint-config-next": "~16.4.2",
    "json-schema-to-typescript": "~16.0.0",
    "prettier": "~3.9.10",
    "tailwindcss": "~4.3.3",
    "tsx": "~4.23.15",
    "typescript": "~5.9.3",
    "vitest": "~5.0.5"
  },
  "overrides": {
    "effect": "3.21.5"
  }
}
