{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.grid.ph/feasibility-studio/v1/envelope.schema.json",
  "title": "GRID DAG ResultEnvelope",
  "description": "The one response shape every DAG returns, for every product, success or failure. The front end reads 'product' to pick the payload schema and renderer. 'report' is null unless status is succeeded or needs_review, and then it must validate against the product schema. Nothing else is ever returned. Since envelope 1.0 (schema set 1.1): teaser_intake is also a product, returned by grid.teaser_intake before the broker confirms; its report is a teaser_intake payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "schema_version",
    "product",
    "report_id",
    "run",
    "report",
    "errors",
    "warnings"
  ],
  "properties": {
    "envelope_version": {
      "const": "1.0"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "description": "Version of the product payload schema the report was validated against."
    },
    "product": {
      "type": "string",
      "enum": [
        "quick_report",
        "executive_summary",
        "feasibility_report",
        "teaser_intake"
      ]
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "dag_id",
        "dag_version",
        "status",
        "submitted_at"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "dag_id": {
          "type": "string",
          "enum": [
            "grid.quick_report",
            "grid.executive_summary",
            "grid.feasibility_report",
            "grid.teaser_intake"
          ]
        },
        "dag_version": {
          "type": "string"
        },
        "prompt_pack_version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "needs_review",
            "failed",
            "cancelled"
          ]
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completed_nodes",
            "total_nodes"
          ],
          "properties": {
            "completed_nodes": {
              "type": "integer",
              "minimum": 0
            },
            "total_nodes": {
              "type": "integer",
              "minimum": 1
            },
            "current_node": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "status"
            ],
            "properties": {
              "node_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "succeeded",
                  "failed",
                  "skipped",
                  "retried"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "started_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "finished_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "report": {
      "description": "The product payload (quick_report, executive_summary or feasibility_report schema), or null.",
      "type": [
        "object",
        "null"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Problem"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Problem"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run": {
            "properties": {
              "status": {
                "enum": [
                  "succeeded",
                  "needs_review"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "report": {
            "type": "object"
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run": {
            "properties": {
              "status": {
                "enum": [
                  "queued",
                  "running",
                  "failed",
                  "cancelled"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "report": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "quick_report"
          },
          "report": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "report": {
            "$ref": "quick_report.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "executive_summary"
          },
          "report": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "report": {
            "$ref": "executive_summary.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "feasibility_report"
          },
          "report": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "report": {
            "$ref": "feasibility_report.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "teaser_intake"
          },
          "report": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "report": {
            "$ref": "teaser_intake.schema.json"
          }
        }
      }
    }
  ],
  "$defs": {
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INPUT_INVALID",
            "INPUT_INSUFFICIENT",
            "DOCUMENT_UNREADABLE",
            "NODE_FAILED",
            "NODE_TIMEOUT",
            "PROVIDER_UNAVAILABLE",
            "SCHEMA_INVALID",
            "RUN_CANCELLED",
            "RATE_LIMITED",
            "INTERNAL",
            "QA_BLOCKER",
            "LOW_EVIDENCE"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "JSON path inside the report, for SCHEMA_INVALID and QA findings."
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}