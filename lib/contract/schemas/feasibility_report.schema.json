{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.grid.ph/feasibility-studio/v1/feasibility_report.schema.json",
  "title": "GRID Feasibility Report",
  "description": "Final output of the Feasibility Report DAG. Follows the standard feasibility report order from the training guide, with three GRID additions marked 'added': methodology_limitations, risk_sensitivity and legal_regulatory (inside technical_study). Sections GRID cannot fill honestly carry coverage 'inputs_required' and an InputsRequiredBlock rather than generated text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "front_matter",
    "sections",
    "criteria",
    "financials",
    "limitations",
    "sources",
    "claims",
    "qa"
  ],
  "properties": {
    "meta": {
      "$ref": "common.schema.json#/$defs/Meta"
    },
    "front_matter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cover",
        "executive_summary",
        "toc_mode"
      ],
      "properties": {
        "cover": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "subtitle",
            "date"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "subtitle": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "hero_image": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            }
          }
        },
        "executive_summary": {
          "description": "Embedded Executive Summary (mode 'derived'). Generated last, from the finished sections.",
          "$ref": "executive_summary.schema.json"
        },
        "toc_mode": {
          "description": "The front end builds the table of contents from 'sections'. 'summary_first' = Cover, Executive Summary, Contents (order in the Parts slide). 'toc_first' = Cover, Contents, Executive Summary (order in the Executive Summary slide).",
          "type": "string",
          "enum": [
            "summary_first",
            "toc_first"
          ]
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "introduction",
        "project_description",
        "feasibility_criteria",
        "marketing_plan",
        "technical_study",
        "socio_economic_political",
        "environmental",
        "organizational_management",
        "risk_sensitivity",
        "methodology_limitations",
        "findings_recommendations",
        "conclusion",
        "annex"
      ],
      "properties": {
        "introduction": {
          "$ref": "common.schema.json#/$defs/Section"
        },
        "project_description": {
          "$ref": "common.schema.json#/$defs/Section"
        },
        "feasibility_criteria": {
          "$ref": "common.schema.json#/$defs/Section",
          "description": "Narrative and table view of the 'criteria' array."
        },
        "marketing_plan": {
          "$ref": "common.schema.json#/$defs/Section"
        },
        "technical_study": {
          "$ref": "common.schema.json#/$defs/Section"
        },
        "socio_economic_political": {
          "$ref": "common.schema.json#/$defs/Section"
        },
        "environmental": {
          "$ref": "common.schema.json#/$defs/Section"
        },
        "organizational_management": {
          "$ref": "common.schema.json#/$defs/Section"
        },
        "risk_sensitivity": {
          "$ref": "common.schema.json#/$defs/Section",
          "description": "added"
        },
        "methodology_limitations": {
          "$ref": "common.schema.json#/$defs/Section",
          "description": "added"
        },
        "findings_recommendations": {
          "$ref": "common.schema.json#/$defs/Section"
        },
        "conclusion": {
          "$ref": "common.schema.json#/$defs/Section"
        },
        "annex": {
          "$ref": "common.schema.json#/$defs/Section"
        }
      }
    },
    "criteria": {
      "description": "Go/no-go criteria fixed by the planner node before research starts. The verdict is scored against these, so the result cannot be fitted to the findings afterwards.",
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "weight",
          "threshold",
          "result",
          "passed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^K-[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "market",
              "technical",
              "legal_regulatory",
              "environmental",
              "socio_economic",
              "financial",
              "organizational"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "threshold": {
            "type": "string",
            "description": "e.g. 'Zoning permits commercial use' or 'IRR >= 15%'"
          },
          "result": {
            "type": "string"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          },
          "passed": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null = cannot be judged with the inputs supplied"
          },
          "is_gate": {
            "type": "boolean",
            "description": "A failed gate makes the project not feasible whatever the total score."
          },
          "limitation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "financials": {
      "description": "Produced by the deterministic financial engine, never by a language model. Each statement is null when the owner has not supplied the inputs it needs; the matching Limitation explains why.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "assumptions",
        "balance_sheet",
        "income_statement",
        "cash_flow",
        "break_even",
        "capital_requirement",
        "returns",
        "scenarios",
        "market_price_outlook"
      ],
      "properties": {
        "coverage": {
          "$ref": "common.schema.json#/$defs/Coverage"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "figure"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "figure": {
                "$ref": "common.schema.json#/$defs/Figure"
              },
              "basis_note": {
                "description": "Where the assumption comes from, in plain words (e.g. 'Asking price \u00d7 lot area (S-001)'). Shown in client reports.",
                "type": "string",
                "maxLength": 160
              }
            }
          }
        },
        "balance_sheet": {
          "oneOf": [
            {
              "$ref": "#/$defs/Statement"
            },
            {
              "type": "null"
            }
          ]
        },
        "income_statement": {
          "oneOf": [
            {
              "$ref": "#/$defs/Statement"
            },
            {
              "type": "null"
            }
          ]
        },
        "cash_flow": {
          "oneOf": [
            {
              "$ref": "#/$defs/Statement"
            },
            {
              "type": "null"
            }
          ]
        },
        "break_even": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "units_or_sqm",
                "revenue",
                "period"
              ],
              "properties": {
                "units_or_sqm": {
                  "$ref": "common.schema.json#/$defs/Figure"
                },
                "revenue": {
                  "$ref": "common.schema.json#/$defs/Figure"
                },
                "period": {
                  "$ref": "common.schema.json#/$defs/Figure"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "capital_requirement": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "uses",
                "sources_of_funds"
              ],
              "properties": {
                "total": {
                  "$ref": "common.schema.json#/$defs/Figure"
                },
                "uses": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/FundLine"
                  }
                },
                "sources_of_funds": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/FundLine"
                  }
                },
                "strategy": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "returns": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "npv",
                "irr",
                "payback",
                "discount_rate"
              ],
              "properties": {
                "npv": {
                  "$ref": "common.schema.json#/$defs/Figure"
                },
                "irr": {
                  "$ref": "common.schema.json#/$defs/Figure"
                },
                "payback": {
                  "$ref": "common.schema.json#/$defs/Figure"
                },
                "discount_rate": {
                  "$ref": "common.schema.json#/$defs/Figure"
                },
                "equity_multiple": {
                  "$ref": "common.schema.json#/$defs/Figure"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "scenarios": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "changes",
              "irr",
              "npv"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "downside",
                  "base",
                  "upside"
                ]
              },
              "changes": {
                "type": "string"
              },
              "irr": {
                "$ref": "common.schema.json#/$defs/Figure"
              },
              "npv": {
                "$ref": "common.schema.json#/$defs/Figure"
              }
            }
          }
        },
        "market_price_outlook": {
          "description": "GRID's five-year price outlook (from Market Insight). Shown as market context, never labelled as a financial projection.",
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/ChartBlock"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "limitations": {
      "description": "Every gap in the report and the input that would close it. Rendered on the Methodology and Limitations page and as badges on affected sections.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Limitation"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/Source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Claim"
      }
    },
    "qa": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/QaCheck"
      }
    }
  },
  "$defs": {
    "Statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periods",
        "currency",
        "scale",
        "lines"
      ],
      "properties": {
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "currency": {
          "type": "string",
          "default": "PHP"
        },
        "scale": {
          "type": "string",
          "enum": [
            "one",
            "thousand",
            "million"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "values",
              "status"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "is_total": {
                "type": "boolean"
              },
              "status": {
                "$ref": "common.schema.json#/$defs/VerificationStatus"
              },
              "formula": {
                "description": "Human-readable formula from the engine, for audit.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "FundLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "figure"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "figure": {
          "$ref": "common.schema.json#/$defs/Figure"
        }
      }
    }
  }
}