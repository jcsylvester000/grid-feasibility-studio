{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://schemas.grid.ph/feasibility-studio/v1/node_io.schema.json",
 "title": "GRID Feasibility Studio - AI node inputs and outputs",
 "description": "Runtime inputs passed to every AI node (RunContext, FieldDictionary) and the intermediate JSON each AI node returns. Final products still validate against feasibility_report / executive_summary / quick_report schemas; these are the hand-offs between nodes. Every output also allows 'issues' so a node can report problems (including possible instructions found inside inputs) without breaking the schema.",
 "$defs": {
  "RunContext": {
   "description": "Built by the harness (N01 / E01 / Q01). Tells each node where it is and what it may do.",
   "type": "object",
   "additionalProperties": true,
   "required": [
    "report_id",
    "product",
    "today",
    "market",
    "input_level"
   ],
   "properties": {
    "report_id": {
     "type": "string"
    },
    "product": {
     "type": "string",
     "enum": [
      "feasibility_report",
      "executive_summary",
      "quick_report"
     ]
    },
    "tier": {
     "type": "string",
     "enum": [
      "desk",
      "full"
     ]
    },
    "today": {
     "type": "string",
     "format": "date"
    },
    "market": {
     "type": "object",
     "additionalProperties": true,
     "required": [
      "country",
      "currency"
     ],
     "properties": {
      "country": {
       "type": "string",
       "description": "ISO 3166-1 alpha-2. Default PH."
      },
      "currency": {
       "type": "string",
       "description": "ISO 4217. Default PHP."
      },
      "locale": {
       "type": "string",
       "description": "e.g. en-PH"
      }
     }
    },
    "input_level": {
     "$ref": "common.schema.json#/$defs/InputLevel"
    },
    "verdict_ceiling": {
     "type": "string",
     "enum": [
      "feasible",
      "conditionally_feasible",
      "not_feasible",
      "insufficient_data",
      "promising",
      "marginal",
      "weak",
      "cannot_tell"
     ],
     "description": "Strongest verdict the inputs allow. Code enforces it again after the model."
    },
    "enabled_nodes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "pre_limitations": {
     "type": "array",
     "items": {
      "$ref": "common.schema.json#/$defs/Limitation"
     }
    },
    "front_end_version": {
     "type": "string",
     "description": "Lets the run log tie a report to the form version that produced it."
    }
   }
  },
  "FieldDictionary": {
   "description": "Generated by the front end from its live option lists (options.js) at request time, so prompts never hard-code dropdown choices. One entry per intake key.",
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": true,
    "required": [
     "key",
     "label",
     "type"
    ],
    "properties": {
     "key": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "type": {
      "type": "string",
      "enum": [
       "choice",
       "multi_choice",
       "number",
       "range",
       "text",
       "boolean",
       "date",
       "file",
       "location",
       "other"
      ]
     },
     "meaning": {
      "type": "string",
      "description": "One plain sentence: what the field tells us."
     },
     "unit": {
      "type": "string"
     },
     "capability": {
      "type": "string",
      "description": "Canonical capability this field satisfies (an InputsProvided key such as lot_area or development_cost). Lets the gate compute the input level even when field keys change."
     },
     "provider_tag": {
      "type": "string",
      "enum": [
       "can",
       "idea",
       "cant",
       "system"
      ]
     },
     "options": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": true,
       "required": [
        "value",
        "label"
       ],
       "properties": {
        "value": {
         "type": [
          "string",
          "number",
          "boolean"
         ]
        },
        "label": {
         "type": "string"
        },
        "maps_to": {
         "type": "object",
         "additionalProperties": true,
         "properties": {
          "low": {
           "type": [
            "number",
            "null"
           ]
          },
          "base": {
           "type": [
            "number",
            "null"
           ]
          },
          "high": {
           "type": [
            "number",
            "null"
           ]
          },
          "unit": {
           "type": "string"
          },
          "canonical": {
           "type": "string",
           "description": "Canonical enum value, e.g. a schema intended_use value."
          }
         }
        },
        "means_unknown": {
         "type": "boolean"
        }
       }
      }
     }
    }
   }
  },
  "Issue": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "detail"
   ],
   "properties": {
    "type": {
     "type": "string",
     "enum": [
      "possible_instruction_in_input",
      "uninterpreted_field",
      "input_conflict",
      "unreadable_input",
      "tool_failure",
      "out_of_scope_request",
      "other"
     ]
    },
    "detail": {
     "type": "string",
     "maxLength": 600
    },
    "where": {
     "type": "string"
    }
   }
  },
  "InputInterpretation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "interpreted_as",
    "status"
   ],
   "properties": {
    "key": {
     "type": "string"
    },
    "raw": {
     "type": [
      "string",
      "number",
      "boolean",
      "null"
     ]
    },
    "interpreted_as": {
     "type": "string"
    },
    "figure": {
     "oneOf": [
      {
       "$ref": "#/$defs/LooseFigure"
      },
      {
       "type": "null"
      }
     ]
    },
    "status": {
     "type": "string",
     "enum": [
      "owner_input",
      "estimate",
      "missing",
      "uninterpreted",
      "conflict"
     ]
    },
    "note": {
     "type": "string",
     "maxLength": 300
    }
   }
  },
  "LooseFigure": {
   "description": "A Figure before ids are assigned. source_refs are node-local references (n05-s01, doc-1 p3, intake.lot_area); the merge node turns them into S- ids.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "value",
    "range",
    "unit",
    "as_of",
    "basis",
    "status"
   ],
   "properties": {
    "value": {
     "type": [
      "number",
      "null"
     ]
    },
    "range": {
     "oneOf": [
      {
       "$ref": "common.schema.json#/$defs/Range"
      },
      {
       "type": "null"
      }
     ]
    },
    "unit": {
     "type": "string"
    },
    "scale": {
     "type": "string",
     "enum": [
      "one",
      "thousand",
      "million",
      "billion"
     ]
    },
    "as_of": {
     "type": [
      "string",
      "null"
     ]
    },
    "basis": {
     "$ref": "common.schema.json#/$defs/PriceBasis"
    },
    "status": {
     "$ref": "common.schema.json#/$defs/VerificationStatus"
    },
    "source_refs": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "note": {
     "type": "string",
     "maxLength": 300
    }
   }
  },
  "Plan": {
   "description": "N02 output.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "objective",
    "decision_question",
    "asset_reasoning",
    "input_interpretation",
    "criteria",
    "research_questions",
    "load_bearing_figures",
    "assumptions",
    "issues"
   ],
   "properties": {
    "objective": {
     "type": "string",
     "maxLength": 400
    },
    "decision_question": {
     "type": "string",
     "maxLength": 240
    },
    "asset_reasoning": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "asset_class",
      "canonical_intended_use",
      "value_drivers",
      "key_unknowns"
     ],
     "properties": {
      "asset_class": {
       "type": "string"
      },
      "canonical_intended_use": {
       "type": "string",
       "enum": [
        "residential_subdivision",
        "residential_condominium",
        "commercial",
        "mixed_use",
        "industrial_warehouse",
        "hospitality_resort",
        "agricultural",
        "institutional",
        "land_banking",
        "other"
       ]
      },
      "intended_use_detail": {
       "type": "string"
      },
      "value_drivers": {
       "type": "array",
       "minItems": 3,
       "maxItems": 8,
       "items": {
        "type": "string"
       }
      },
      "key_unknowns": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "input_interpretation": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/InputInterpretation"
     }
    },
    "criteria": {
     "type": "array",
     "minItems": 3,
     "maxItems": 12,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "name",
       "category",
       "weight",
       "threshold",
       "is_gate",
       "measured_by",
       "requires_inputs"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^K-[0-9]{2}$"
       },
       "name": {
        "type": "string"
       },
       "category": {
        "type": "string",
        "enum": [
         "market",
         "technical",
         "legal_regulatory",
         "environmental",
         "socio_economic",
         "financial",
         "organizational"
        ]
       },
       "weight": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "threshold": {
        "type": "string"
       },
       "is_gate": {
        "type": "boolean"
       },
       "measured_by": {
        "type": "string",
        "description": "Which evidence or engine output decides it."
       },
       "requires_inputs": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "User inputs still missing that this criterion needs; empty when it can be judged."
       }
      }
     }
    },
    "research_questions": {
     "type": "object",
     "description": "Keyed by research node id, only for enabled nodes.",
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "q_id",
        "question",
        "why",
        "criterion_ids",
        "source_types",
        "recency",
        "must_answer"
       ],
       "properties": {
        "q_id": {
         "type": "string"
        },
        "question": {
         "type": "string"
        },
        "why": {
         "type": "string"
        },
        "criterion_ids": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "source_types": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "recency": {
         "type": "string",
         "description": "e.g. last 12 months, current ordinance, latest census"
        },
        "geography": {
         "type": "string"
        },
        "must_answer": {
         "type": "boolean"
        }
       }
      }
     }
    },
    "load_bearing_figures": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "key",
       "label",
       "why",
       "criterion_ids"
      ],
      "properties": {
       "key": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "why": {
        "type": "string"
       },
       "criterion_ids": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "expected_basis": {
        "$ref": "common.schema.json#/$defs/PriceBasis"
       }
      }
     }
    },
    "section_briefs": {
     "type": "object",
     "description": "Keyed by feasibility report section id. Optional hints for N13.",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "focus": {
        "type": "string"
       },
       "criterion_ids": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "word_range": {
        "type": "string"
       }
      }
     }
    },
    "assumptions": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "issues": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Issue"
     }
    }
   }
  },
  "DocExtraction": {
   "description": "N03 output.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "documents",
    "cross_checks",
    "red_flags",
    "issues"
   ],
   "properties": {
    "documents": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "doc_ref",
       "doc_type",
       "readable",
       "fields"
      ],
      "properties": {
       "doc_ref": {
        "type": "string"
       },
       "doc_type": {
        "type": "string",
        "description": "What the document actually is, in plain words (e.g. 'Transfer Certificate of Title', 'Tax Declaration - land', 'Zoning certification', 'unrelated photo')."
       },
       "capability": {
        "type": "string",
        "description": "InputsProvided key this document satisfies, or 'none'."
       },
       "issuer": {
        "type": "string"
       },
       "issued_on": {
        "type": [
         "string",
         "null"
        ]
       },
       "valid_until": {
        "type": [
         "string",
         "null"
        ]
       },
       "pages": {
        "type": [
         "integer",
         "null"
        ]
       },
       "readable": {
        "type": "string",
        "enum": [
         "yes",
         "partly",
         "no"
        ]
       },
       "fields": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "key",
          "label",
          "value_text",
          "page",
          "confidence"
         ],
         "properties": {
          "key": {
           "type": "string"
          },
          "label": {
           "type": "string"
          },
          "value_text": {
           "type": [
            "string",
            "null"
           ]
          },
          "figure": {
           "oneOf": [
            {
             "$ref": "#/$defs/LooseFigure"
            },
            {
             "type": "null"
            }
           ]
          },
          "page": {
           "type": [
            "integer",
            "null"
           ]
          },
          "quote": {
           "type": "string",
           "maxLength": 200
          },
          "confidence": {
           "$ref": "common.schema.json#/$defs/Confidence"
          }
         }
        }
       }
      }
     }
    },
    "cross_checks": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "field",
       "intake_value",
       "document_value",
       "match"
      ],
      "properties": {
       "field": {
        "type": "string"
       },
       "intake_value": {
        "type": [
         "string",
         "null"
        ]
       },
       "document_value": {
        "type": [
         "string",
         "null"
        ]
       },
       "match": {
        "type": "string",
        "enum": [
         "match",
         "minor_difference",
         "mismatch",
         "not_comparable"
        ]
       },
       "note": {
        "type": "string"
       }
      }
     }
    },
    "red_flags": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "flag",
       "severity",
       "doc_ref"
      ],
      "properties": {
       "flag": {
        "type": "string"
       },
       "severity": {
        "type": "string",
        "enum": [
         "high",
         "medium",
         "low"
        ]
       },
       "doc_ref": {
        "type": "string"
       },
       "page": {
        "type": [
         "integer",
         "null"
        ]
       },
       "next_step": {
        "type": "string"
       }
      }
     }
    },
    "issues": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Issue"
     }
    }
   }
  },
  "ResearchBundle": {
   "description": "Output of every research node (N04-N09, E03). Claims are atomic and carry node-local ids; N10 / E04 assign C- and S- ids.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "node_id",
    "answers",
    "claims",
    "sources",
    "gaps",
    "signals",
    "issues"
   ],
   "properties": {
    "node_id": {
     "type": "string"
    },
    "answers": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "q_id",
       "answer",
       "claim_refs",
       "answered"
      ],
      "properties": {
       "q_id": {
        "type": "string"
       },
       "answer": {
        "type": "string",
        "maxLength": 900
       },
       "claim_refs": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "answered": {
        "type": "string",
        "enum": [
         "fully",
         "partly",
         "no"
        ]
       }
      }
     }
    },
    "claims": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "ref",
       "text",
       "source_refs",
       "confidence",
       "geography_match"
      ],
      "properties": {
       "ref": {
        "type": "string",
        "description": "e.g. n05-c07"
       },
       "text": {
        "type": "string",
        "maxLength": 600
       },
       "figure": {
        "oneOf": [
         {
          "$ref": "#/$defs/LooseFigure"
         },
         {
          "type": "null"
         }
        ]
       },
       "source_refs": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string"
        }
       },
       "evidence_quote": {
        "type": "string",
        "maxLength": 300,
        "description": "Short passage from the source that supports the claim."
       },
       "confidence": {
        "$ref": "common.schema.json#/$defs/Confidence"
       },
       "geography_match": {
        "type": "string",
        "enum": [
         "site",
         "barangay",
         "city_municipality",
         "province",
         "region",
         "national",
         "proxy_area"
        ]
       },
       "kind": {
        "type": "string",
        "enum": [
         "fact",
         "inference",
         "sentiment"
        ]
       },
       "conflict": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "ref",
       "title",
       "publisher",
       "type",
       "tier",
       "accessed_on"
      ],
      "properties": {
       "ref": {
        "type": "string",
        "description": "e.g. n05-s03"
       },
       "title": {
        "type": "string"
       },
       "publisher": {
        "type": "string"
       },
       "url": {
        "type": [
         "string",
         "null"
        ]
       },
       "type": {
        "type": "string",
        "enum": [
         "government_registry",
         "government_report",
         "listing_portal",
         "marketplace",
         "news",
         "research_firm",
         "developer_disclosure",
         "owner_document",
         "forum_or_social",
         "other"
        ]
       },
       "tier": {
        "type": "string",
        "enum": [
         "A",
         "B",
         "C"
        ]
       },
       "published_on": {
        "type": [
         "string",
         "null"
        ]
       },
       "accessed_on": {
        "type": "string"
       }
      }
     }
    },
    "comparables": {
     "description": "Market nodes only (N05, Q02). One row per listing or transaction.",
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "ref",
       "location",
       "basis",
       "source_ref"
      ],
      "properties": {
       "ref": {
        "type": "string"
       },
       "description": {
        "type": "string"
       },
       "location": {
        "type": "string"
       },
       "use_or_type": {
        "type": "string"
       },
       "area_sqm": {
        "type": [
         "number",
         "null"
        ]
       },
       "price_total": {
        "type": [
         "number",
         "null"
        ]
       },
       "price_per_sqm": {
        "type": [
         "number",
         "null"
        ]
       },
       "rent_per_sqm_month": {
        "type": [
         "number",
         "null"
        ]
       },
       "currency": {
        "type": "string"
       },
       "basis": {
        "$ref": "common.schema.json#/$defs/PriceBasis"
       },
       "listed_or_dated_on": {
        "type": [
         "string",
         "null"
        ]
       },
       "similarity": {
        "type": "string",
        "enum": [
         "close",
         "fair",
         "weak"
        ]
       },
       "source_ref": {
        "type": "string"
       }
      }
     }
    },
    "gaps": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "q_id",
       "what_is_missing",
       "limitation_kind"
      ],
      "properties": {
       "q_id": {
        "type": "string"
       },
       "what_is_missing": {
        "type": "string"
       },
       "limitation_kind": {
        "type": "string",
        "enum": [
         "missing_user_input",
         "no_public_data",
